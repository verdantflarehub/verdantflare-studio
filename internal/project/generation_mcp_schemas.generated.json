[
  {
    "name": "project.generation_propose",
    "description": "Archive an immutable generation plan for human review. Does not authorize or run generation.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "plan_id",
        "revision_id",
        "preparation_sha256",
        "stage",
        "call_limit",
        "expires_at",
        "attempts"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "preparation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stage": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "call_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation_id",
              "object_id",
              "state_id",
              "purpose",
              "tool",
              "service_version",
              "arguments"
            ],
            "properties": {
              "operation_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "object_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              },
              "state_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              },
              "tool": {
                "enum": [
                  "image.create",
                  "image.edit"
                ]
              },
              "service_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "arguments": {
                "type": "object",
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "project_id"
                      ]
                    },
                    {
                      "required": [
                        "idempotency_key"
                      ]
                    },
                    {
                      "required": [
                        "approval"
                      ]
                    },
                    {
                      "required": [
                        "approved"
                      ]
                    },
                    {
                      "required": [
                        "authorization"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "project.generation_status",
    "description": "Read the fixed generation plan, human decision and occupied call allowance.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "plan_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    }
  },
  {
    "name": "project.generation_revoke",
    "description": "Revoke new execution. Existing unknown or submitted calls retain their allowance.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "plan_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    }
  },
  {
    "name": "project.generation_submit",
    "description": "Execute an approved fixed attempt once through Studio. Replay reads the prior operation and never starts another attempt.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "plan_id",
        "operation_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    }
  }
]
