  "station://contracts/appcenter-v1/presentation": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/appcenter-v1/presentation",
    "title": "AppCenterPresentationRegistry",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "revision": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "groups": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "$ref": "station://contracts/appcenter-v1/common#/$defs/group"
        }
      },
      "records": {
        "type": "array",
        "maxItems": 1000,
        "items": {
          "type": "object",
          "properties": {
            "appId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            "appVersion": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "display": {
              "$ref": "station://contracts/appcenter-v1/common#/$defs/display"
            },
            "sourceRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sourceDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "appId",
            "appVersion",
            "display",
            "sourceRef",
            "sourceDigest"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "appVersion": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "display": {
                    "properties": {
                      "resourceTags": {
                        "maxItems": 0
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "required": [
      "schemaVersion",
      "revision",
      "groups",
      "records"
    ],
    "additionalProperties": false
  },
