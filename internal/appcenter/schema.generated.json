  "station://contracts/v1/app-catalog-item": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/v1/app-catalog-item",
    "title": "AppCatalogItem",
    "type": "object",
    "required": [
      "app_id",
      "display_name",
      "group_id",
      "brand",
      "models",
      "source",
      "namespace",
      "workload_name",
      "version",
      "images",
      "model_status",
      "deployment"
    ],
    "properties": {
      "app_id": {
        "type": "string",
        "minLength": 1
      },
      "display_name": {
        "type": "string",
        "minLength": 1
      },
      "group_id": {
        "enum": [
          "image",
          "music",
          "video",
          "system",
          "desktop",
          "blender"
        ]
      },
      "brand": {
        "enum": [
          "vf",
          "minimax",
          "github"
        ]
      },
      "models": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "source": {
        "type": "string",
        "minLength": 1
      },
      "namespace": {
        "type": "string",
        "minLength": 1
      },
      "workload_name": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
      },
      "images": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "component",
            "image"
          ],
          "properties": {
            "component": {
              "type": "string",
              "minLength": 1
            },
            "image": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "minItems": 1
      },
      "model_status": {
        "enum": [
          "unknown",
          "not_required"
        ]
      },
      "deployment": {
        "type": "object",
        "required": [
          "state",
          "reason",
          "observed_at",
          "desired_replicas",
          "ready_replicas",
          "images"
        ],
        "properties": {
          "state": {
            "enum": [
              "unknown",
              "not_installed",
              "stopped",
              "stopping",
              "starting",
              "ready",
              "degraded"
            ]
          },
          "reason": {
            "enum": [
              "unavailable",
              "forbidden",
              "invalid_response",
              "not_found",
              "reconciling",
              "scaling_down",
              "scaled_to_zero",
              "deployment_failed",
              "replicas_ready"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "desired_replicas": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "ready_replicas": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "component",
                "image"
              ],
              "properties": {
                "component": {
                  "type": "string",
                  "minLength": 1
                },
                "image": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "uid": {
            "type": "string",
            "format": "uuid"
          },
          "management_status": {
            "enum": [
              "unknown",
              "unmanaged",
              "managed",
              "foreign"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
