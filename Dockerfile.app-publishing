FROM golang:1.26-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/app-publishing-relay/ cmd/app-publishing-relay/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /app-publishing-relay ./cmd/app-publishing-relay

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /app-publishing-relay /app-publishing-relay
EXPOSE 8090
ENTRYPOINT ["/app-publishing-relay"]
